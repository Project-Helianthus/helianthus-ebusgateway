{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://project-helianthus.org/schemas/portal-catalog-v1.schema.json",
  "title": "Helianthus Gateway Portal Catalog v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract", "catalog_revision", "catalog_digest", "evaluation_instant", "authorization_scope", "domains", "contributions", "resources", "fields", "actions", "quarantines", "descriptors"],
  "properties": {
    "contract": {"const": "helianthus.gateway.portal-catalog/v1"},
    "catalog_revision": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "catalog_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "evaluation_instant": {"type": "string", "format": "date-time"},
    "authorization_scope": {"type": "string"},
    "domains": {"type": "array", "minItems": 5, "maxItems": 5, "prefixItems": [{"$ref": "#/$defs/domain_evse"}, {"$ref": "#/$defs/domain_infrastructure"}, {"$ref": "#/$defs/domain_pv"}, {"$ref": "#/$defs/domain_storage"}, {"$ref": "#/$defs/domain_thermal"}], "items": false},
    "contributions": {"type": "array", "items": {"$ref": "#/$defs/contribution"}},
    "resources": {"type": "array", "items": {"$ref": "#/$defs/resource"}},
    "fields": {"type": "array", "items": {"$ref": "#/$defs/field"}},
    "actions": {"type": "array", "items": {"$ref": "#/$defs/action"}},
    "quarantines": {"type": "array", "items": {"$ref": "#/$defs/quarantine"}},
    "descriptors": {"type": "array", "items": {"$ref": "#/$defs/descriptor"}}
  },
  "$defs": {
    "pack_ref": {"type": "object", "additionalProperties": false, "required": ["id", "version"], "properties": {"id": {"type": "string"}, "version": {"type": "string"}}},
    "domain": {"type": "object", "additionalProperties": false, "required": ["pack", "source_state"], "properties": {"pack": {"$ref": "#/$defs/pack_ref"}, "source_state": {"enum": ["PRESENT", "ABSENT"]}, "reason": {"type": "string"}}},
    "domain_thermal": {"allOf": [{"$ref": "#/$defs/domain"}, {"properties": {"pack": {"const": {"id": "helianthus.pack.thermal", "version": "1.0.0"}}}}]},
    "domain_pv": {"allOf": [{"$ref": "#/$defs/domain"}, {"properties": {"pack": {"const": {"id": "helianthus.pack.pv", "version": "1.0.0"}}}}]},
    "domain_storage": {"allOf": [{"$ref": "#/$defs/domain"}, {"properties": {"pack": {"const": {"id": "helianthus.pack.storage", "version": "1.1.0"}}}}]},
    "domain_evse": {"allOf": [{"$ref": "#/$defs/domain"}, {"properties": {"pack": {"const": {"id": "helianthus.pack.evse", "version": "1.0.0"}}}}]},
    "domain_infrastructure": {"allOf": [{"$ref": "#/$defs/domain"}, {"properties": {"pack": {"const": {"id": "helianthus.pack.infrastructure", "version": "1.0.0"}}}}]},
    "contribution": {"type": "object", "additionalProperties": false, "required": ["driver_id", "manifest_id", "manifest_version", "digest"], "properties": {"driver_id": {"type": "string"}, "manifest_id": {"type": "string"}, "manifest_version": {"type": "string"}, "digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}}},
    "source": {"type": "object", "additionalProperties": false, "required": ["asset_id", "snapshot_id", "revision", "evaluation_digest", "binding_id", "source_epoch", "driver_generation", "snapshot", "evaluation", "selections", "projection"], "properties": {"asset_id": {"type": "string"}, "snapshot_id": {"type": "string"}, "revision": {"type": "string"}, "evaluation_digest": {"type": "string"}, "binding_id": {"type": "string"}, "source_epoch": {"type": "string"}, "driver_generation": {"type": "string", "pattern": "^(0|[1-9][0-9]*)$"}, "snapshot": {"type": "object"}, "evaluation": {"type": "object"}, "selections": {"type": "array"}, "projection": {"type": "object"}}},
    "resource": {"type": "object", "additionalProperties": false, "required": ["id", "domain", "service_id", "capability_id", "contribution_driver_id", "contribution_manifest_id", "contribution_manifest_version", "source", "state"], "properties": {"id": {"type": "string"}, "domain": {"type": "string"}, "service_id": {"type": "string"}, "capability_id": {"type": "string"}, "contribution_driver_id": {"type": "string"}, "contribution_manifest_id": {"type": "string"}, "contribution_manifest_version": {"type": "string"}, "source": {"$ref": "#/$defs/source"}, "state": {"type": "string"}}},
    "field": {"type": "object", "additionalProperties": false, "required": ["id", "resource_id", "definition_id", "unit_id", "contribution_driver_id", "contribution_manifest_id", "contribution_manifest_version", "value", "quality", "projection"], "properties": {"id": {"type": "string"}, "resource_id": {"type": "string"}, "definition_id": {"type": "string"}, "unit_id": {"type": "string"}, "contribution_driver_id": {"type": "string"}, "contribution_manifest_id": {"type": "string"}, "contribution_manifest_version": {"type": "string"}, "value": {}, "quality": {"type": "string"}, "projection": {"type": "string"}}},
    "action": {"type": "object", "additionalProperties": false, "required": ["id", "resource_id", "service_id", "capability_id", "operation_id", "contribution_driver_id", "contribution_manifest_id", "contribution_manifest_version", "source", "discoverable", "enabled"], "properties": {"id": {"type": "string"}, "resource_id": {"type": "string"}, "service_id": {"type": "string"}, "capability_id": {"type": "string"}, "operation_id": {"type": "string"}, "contribution_driver_id": {"type": "string"}, "contribution_manifest_id": {"type": "string"}, "contribution_manifest_version": {"type": "string"}, "source": {"$ref": "#/$defs/source"}, "discoverable": {"type": "boolean"}, "enabled": {"type": "boolean"}, "reason": {"type": "string"}}},
    "quarantine": {"type": "object", "additionalProperties": false, "required": ["driver_id", "manifest_id", "manifest_version", "reason"], "properties": {"driver_id": {"type": "string"}, "manifest_id": {"type": "string"}, "manifest_version": {"type": "string"}, "reason": {"type": "string"}}},
    "descriptor_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "descriptor_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$", "maxLength": 128},
    "descriptor_order": {"type": "integer", "minimum": -2147483648, "maximum": 2147483647},
    "descriptor_label": {"type": "object", "additionalProperties": false, "required": ["key", "default"], "properties": {"key": {"$ref": "#/$defs/descriptor_id"}, "default": {"type": "string", "minLength": 1}}},
    "descriptor_packRef": {"type": "object", "additionalProperties": false, "required": ["id", "version"], "properties": {"id": {"$ref": "#/$defs/descriptor_id"}, "version": {"$ref": "#/$defs/descriptor_version"}}},
    "descriptor_definitionRef": {"type": "object", "additionalProperties": false, "required": ["pack", "id", "version"], "properties": {"pack": {"$ref": "#/$defs/descriptor_packRef"}, "id": {"$ref": "#/$defs/descriptor_id"}, "version": {"$ref": "#/$defs/descriptor_version"}}},
    "descriptor_group": {"type": "object", "additionalProperties": false, "required": ["id", "label", "resource_context", "order"], "properties": {"id": {"$ref": "#/$defs/descriptor_id"}, "label": {"$ref": "#/$defs/descriptor_label"}, "resource_context": {"$ref": "#/$defs/descriptor_id"}, "order": {"$ref": "#/$defs/descriptor_order"}}},
    "descriptor_field": {"type": "object", "additionalProperties": false, "required": ["id", "group", "label", "ref", "service_ref", "capability_ref", "unit_ref", "order"], "properties": {"id": {"$ref": "#/$defs/descriptor_id"}, "group": {"$ref": "#/$defs/descriptor_id"}, "label": {"$ref": "#/$defs/descriptor_label"}, "ref": {"$ref": "#/$defs/descriptor_definitionRef"}, "service_ref": {"$ref": "#/$defs/descriptor_definitionRef"}, "capability_ref": {"$ref": "#/$defs/descriptor_definitionRef"}, "unit_ref": {"$ref": "#/$defs/descriptor_definitionRef"}, "order": {"$ref": "#/$defs/descriptor_order"}}},
    "descriptor_view": {"type": "object", "additionalProperties": false, "required": ["id", "group", "label", "renderer", "slot", "field_ids", "diagnostic_ids", "order"], "properties": {"id": {"$ref": "#/$defs/descriptor_id"}, "group": {"$ref": "#/$defs/descriptor_id"}, "label": {"$ref": "#/$defs/descriptor_label"}, "renderer": {"enum": ["summary", "field_table", "relationship_graph", "state_strip", "timeline", "evidence_table", "session_controls"]}, "slot": {"enum": ["lens", "native_diagnostics"]}, "field_ids": {"type": "array", "items": {"$ref": "#/$defs/descriptor_id"}}, "diagnostic_ids": {"type": "array", "items": {"$ref": "#/$defs/descriptor_id"}}, "order": {"$ref": "#/$defs/descriptor_order"}}},
    "descriptor_diagnostic": {"type": "object", "additionalProperties": false, "required": ["id", "group", "label", "member_id", "kind", "order"], "properties": {"id": {"$ref": "#/$defs/descriptor_id"}, "group": {"$ref": "#/$defs/descriptor_id"}, "label": {"$ref": "#/$defs/descriptor_label"}, "member_id": {"$ref": "#/$defs/descriptor_id"}, "kind": {"enum": ["field", "action"]}, "order": {"$ref": "#/$defs/descriptor_order"}}},
    "descriptor": {"type": "object", "additionalProperties": false, "required": ["driver_id", "manifest_id", "manifest_version", "digest", "descriptor_version", "groups", "fields", "views", "diagnostics"], "properties": {"driver_id": {"type": "string"}, "manifest_id": {"type": "string"}, "manifest_version": {"type": "string"}, "digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}, "descriptor_version": {"const": "helianthus.gateway.portal-descriptor/v1"}, "groups": {"type": "array", "maxItems": 64, "items": {"$ref": "#/$defs/descriptor_group"}}, "fields": {"type": "array", "maxItems": 512, "items": {"$ref": "#/$defs/descriptor_field"}}, "views": {"type": "array", "maxItems": 64, "items": {"$ref": "#/$defs/descriptor_view"}}, "diagnostics": {"type": "array", "maxItems": 128, "items": {"$ref": "#/$defs/descriptor_diagnostic"}}}}
  }
}
