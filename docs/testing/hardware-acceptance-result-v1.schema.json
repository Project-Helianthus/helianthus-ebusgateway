{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Project-Helianthus/helianthus-ebusgateway/raw/main/docs/testing/hardware-acceptance-result-v1.schema.json",
  "title": "Transitional hardware acceptance result v1",
  "description": "Shape only. Catalogue-aware identity, exact inventory, review and category validation is additionally required. Synthetic records never establish live acceptance.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "candidate",
    "session",
    "target",
    "catalogue_version",
    "form",
    "source",
    "records"
  ],
  "properties": {
    "candidate": {
      "type": "string",
      "minLength": 1
    },
    "session": {
      "type": "string",
      "minLength": 1
    },
    "target": {
      "type": "string",
      "minLength": 1
    },
    "catalogue_version": {
      "const": "1"
    },
    "form": {
      "enum": [
        "full88",
        "adaptermux-v2"
      ]
    },
    "source": {
      "enum": [
        "live",
        "synthetic"
      ]
    },
    "records": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/record"
      }
    }
  },
  "$defs": {
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidate",
        "session",
        "target",
        "gate_id",
        "case_id",
        "record_id",
        "review_id",
        "independent",
        "current"
      ],
      "properties": {
        "candidate": {
          "type": "string",
          "minLength": 1
        },
        "session": {
          "type": "string",
          "minLength": 1
        },
        "target": {
          "type": "string",
          "minLength": 1
        },
        "gate_id": {
          "type": "string",
          "minLength": 1
        },
        "case_id": {
          "type": "string",
          "minLength": 1
        },
        "record_id": {
          "type": "string",
          "minLength": 1
        },
        "review_id": {
          "type": "string",
          "minLength": 1
        },
        "independent": {
          "const": true
        },
        "current": {
          "const": true
        }
      }
    },
    "record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidate",
        "session",
        "target",
        "gate_id",
        "case_id",
        "record_id",
        "qualification",
        "admission",
        "scope",
        "procedure",
        "expected",
        "actual",
        "evidence_ref",
        "source",
        "outcome",
        "category",
        "reason",
        "evidence_grade",
        "omissions",
        "review"
      ],
      "properties": {
        "candidate": {
          "type": "string",
          "minLength": 1
        },
        "session": {
          "type": "string",
          "minLength": 1
        },
        "target": {
          "type": "string",
          "minLength": 1
        },
        "gate_id": {
          "type": "string",
          "minLength": 1
        },
        "case_id": {
          "type": "string",
          "minLength": 1
        },
        "record_id": {
          "type": "string",
          "minLength": 1
        },
        "qualification": {
          "type": "string",
          "minLength": 1
        },
        "admission": {
          "type": "string",
          "minLength": 1
        },
        "scope": {
          "type": "string",
          "minLength": 1
        },
        "procedure": {
          "type": "string",
          "minLength": 1
        },
        "expected": {
          "type": "string",
          "minLength": 1
        },
        "actual": {
          "type": "string",
          "minLength": 1
        },
        "evidence_ref": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "enum": [
            "live",
            "synthetic"
          ]
        },
        "outcome": {
          "enum": [
            "pass",
            "fail",
            "timeout",
            "not-run",
            "omitted-checks",
            "xfail",
            "xpass",
            "blocked-infra",
            "planned"
          ]
        },
        "category": {
          "type": "string"
        },
        "reason": {
          "type": "string"
        },
        "evidence_grade": {
          "enum": [
            "Proven",
            "Hypothesis",
            "Unknown"
          ]
        },
        "omissions": {
          "type": "string"
        },
        "review": {
          "$ref": "#/$defs/review"
        }
      }
    }
  }
}
