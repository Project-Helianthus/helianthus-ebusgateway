        "J/m^2",
        "S",
        "S/m",
        "K/s",
        "Pa/s",
        "J/kg_K",
        "Vs",
        "V/m",
        "V/Hz",
        "As",
        "A/m",
        "Hz/s",
        "kg/s",
        "kg_m^2",
        "J/Wh",
        "W/s",
        "ft^3",
        "ft^3/h",
        "ccf",
        "ccf/h",
        "US.liq.gal",
        "US.liq.gal/h",
        "Imp.gal",
        "Imp.gal/h",
        "Btu",
        "Btu/h",
        "Ah",
        "kg/Wh"
