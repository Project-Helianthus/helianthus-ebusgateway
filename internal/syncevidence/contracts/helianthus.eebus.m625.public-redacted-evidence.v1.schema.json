    "NullableQualityV1": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "enum": [
            "OBSERVED",
            "STALE"
          ]
        }
      ]
    },
    "TerminalClassificationV1": {
      "enum": [
        "SUCCESS",
        "INVALID_ARGUMENT",
        "PERMISSION_DENIED",
        "UNSUPPORTED_OPERATION",
        "PARTIAL_OPERATION_FORBIDDEN",
        "CONSTRAINTS_UNKNOWN",
