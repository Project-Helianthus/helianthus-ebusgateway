        },
        "feature": {
          "$ref": "#/$defs/PseudonymV1"
        },
        "feature_path": {
          "type": "array",
          "minItems": 3,
          "maxItems": 32,
          "items": {
            "$ref": "#/$defs/PathSegmentV1"
          }
