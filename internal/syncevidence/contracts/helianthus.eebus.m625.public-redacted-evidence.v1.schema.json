        },
        "value": {
          "$ref": "#/$defs/NullableValueV1"
        },
        "unit": {
          "$ref": "#/$defs/NullableUnitV1"
        },
        "quality": {
          "$ref": "#/$defs/NullableQualityV1"
        }
      },
      "allOf": [
        {
          "oneOf": [
            {
              "properties": {
                "feature_type": {
                  "const": "Measurement"
                },
                "function": {
                  "const": "measurementListData"
                },
                "value_type": {
                  "enum": [
