      "properties": {
        "kind": {
          "enum": [
            "SERVICE",
            "ENTITY",
            "FEATURE",
            "FIELD"
          ]
        },
        "selector": {
          "$ref": "#/$defs/PseudonymV1"
        }
      }
    },
    "EEBusPathV1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "service",
        "entity",
        "feature",
        "feature_path"
      ],
      "properties": {
        "service": {
          "$ref": "#/$defs/PseudonymV1"
