+func newMatterBindingFeedInstanceID() (string, error) {
+	var value [16]byte
+	if _, err := rand.Read(value[:]); err != nil {
+		return "", err
+	}
+	return "matter-" + hex.EncodeToString(value[:]), nil
+}
